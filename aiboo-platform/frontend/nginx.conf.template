# Templated by the official nginx image (envsubst at container start).
# Available variables (set on the frontend service in docker-compose):
#   ${BACKEND_HOST}   – Node backend hostname (default: backend)
#   ${AGENT_HOST}     – Python agent hostname    (default: agent)
#   ${CV_HOST}        – CV service hostname      (default: cv-service)
#   ${CV_AUTH_TOKEN}  – token injected server-side on proxied CV calls
#
# The SPA calls everything same-origin via relative URLs:
#   /api/**      → backend   /api/**
#   /socket.io   → backend   /socket.io (websocket upgrade)
#   /agent-api/**→ agent     /**        (prefix stripped)
#   /cv-api/**   → cv-service /**       (prefix stripped + auth injected)
server {
    listen 5173;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers for the SPA shell
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---- Node backend REST API ----
    location /api {
        proxy_pass http://${BACKEND_HOST}:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---- Socket.IO (websocket) ----
    location /socket.io {
        proxy_pass http://${BACKEND_HOST}:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;   # long-lived sockets
        proxy_send_timeout 3600s;
    }

    # ---- Python agent (health + event feed) ----
    location /agent-api/ {
        proxy_pass http://${AGENT_HOST}:8001/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }

    # ---- CV service (camera registration + MJPEG streams) ----
    # The <img> tags used for MJPEG tiles cannot send Authorization headers,
    # so nginx injects the CV bearer token server-side. The browser never
    # receives (or needs) the CV token.
    location /cv-api/ {
        proxy_pass http://${CV_HOST}:5050/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Authorization "Bearer ${CV_AUTH_TOKEN}";
        # MJPEG = long-lived chunked response
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Static assets with long cache (Vite fingerprints filenames)
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
