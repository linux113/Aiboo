# ═══════════════════════════════════════════════════════════════════
# AiBoO Platform — docker-compose environment
# Copy to .env and fill in REAL values:   cp .env.example .env
# Generate secrets:                       openssl rand -hex 32
# NEVER commit the real .env file.
# ═══════════════════════════════════════════════════════════════════

# ---- Runtime mode ----
NODE_ENV=production
AIBOO_ENV=production

# ---- Token lifetimes ----
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d

# ---- Redis (optional, recommended for multi-instance) ----
# Start the redis service with: docker compose --profile redis up -d
# Unset = in-memory fallback (single backend instance only)
# REDIS_URL=redis://redis:6379

# ---- Data retention ----
# Detections auto-delete after this many days (Mongo TTL index)
DETECTION_RETENTION_DAYS=90

# ---- API docs ----
# Swagger UI at /api/docs (spec at /api/docs.json).
# Dev: public. Production: admin/analyst JWT required unless PUBLIC_DOCS=true.
DOCS_ENABLED=true
# PUBLIC_DOCS=true

# ---- Alert notifications (Phase 4; all optional) ----
# Generic HMAC-signed webhook / Slack / PagerDuty / SIEM CEF forwarding.
# Test after deploy: POST /api/notifications/test (admin).
# ALERT_WEBHOOK_URL=
# ALERT_SLACK_WEBHOOK_URL=
# ALERT_PAGERDUTY_ROUTING_KEY=
# SIEM_WEBHOOK_URL=
# NOTIFICATION_HMAC_SECRET=
ALERT_NOTIFY_SEVERITIES=critical

# ---- Shared secrets (generate each with: openssl rand -hex 32) ----
# Signs JWTs for user auth (backend)
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# Agent -> backend ingest (X-API-Key on /api/agent/*)
AGENT_API_KEY=<generate-with-openssl-rand-hex-32>

# Dashboard/backend -> agent internal endpoints
INTERNAL_API_KEY=<generate-with-openssl-rand-hex-32>

# CV service -> backend detection ingest (X-API-Key on /api/cameras/detections)
CV_INGEST_KEY=<generate-with-openssl-rand-hex-32>

# CV service management API (Bearer on /cameras/* incl. MJPEG streams)
CV_AUTH_TOKEN=<generate-with-openssl-rand-hex-32>

# Backend service-to-service keys, comma-separated (X-API-Key via API_KEYS)
API_KEYS=<generate-with-openssl-rand-hex-32>

# ---- LLM (optional) ----
OPENAI_KEY=
ANTHROPIC_API_KEY=

# ---- Agent identity & engines ----
ENDPOINT_NAME=aiboo-agent-01
RUN_ORCHESTRATOR=true
ENABLE_COMMAND_DASHBOARD=true
# Action engines take REAL host actions (kill processes / lock endpoints) — opt-in
ENABLE_AUTONOMOUS_RESPONSE=false
ENABLE_REAL_RESPONSE=false

# ---- Networking ----
# Frontend origins allowed by backend CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ---- Data ----
SEED_DEMO_DATA=false
LOG_LEVEL=info
