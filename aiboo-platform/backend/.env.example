# ── Backend ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/aiboo

# JWT — generate with: openssl rand -hex 32
# (production boots FAIL if this is missing/default/short)
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# OpenAI (optional — AI chat falls back to heuristics without it)
OPENAI_KEY=

# Service URLs
AGENT_SERVICE_URL=http://localhost:8001
CV_SERVICE_URL=http://localhost:5050

# Logging
LOG_LEVEL=info

# ── Service-to-service auth (ALL timing-safe compared) ───
# Agent -> backend ingest (X-API-Key on /api/agent/*)
AGENT_API_KEY=<generate-with-openssl-rand-hex-32>

# CV service -> backend detection ingest (X-API-Key on POST /api/cameras/detections).
# Must match CV_INGEST_KEY in cv-service env. If unset, the ingest endpoint
# is UNAUTHENTICATED (development only — production boot check enforces it).
CV_INGEST_KEY=<generate-with-openssl-rand-hex-32>

# Comma-separated keys accepted by `protect` for service calls (X-API-Key)
API_KEYS=<generate-with-openssl-rand-hex-32>

# CORS origins (comma-separated; '*' only in development)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Trust proxy count (set to number of reverse proxies in front)
TRUST_PROXY=1

# Seed demo agent findings on boot (dev only)
SEED_DEMO_DATA=false
