# ── Backend ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/aiboo

# JWT — generate with: openssl rand -hex 32
# (production boots FAIL if this is missing/default/short)
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# OpenAI (optional — AI chat falls back to heuristics without it)
OPENAI_KEY=

# Service URLs
AGENT_SERVICE_URL=http://localhost:8001
CV_SERVICE_URL=http://localhost:5050

# Logging
LOG_LEVEL=info

# ── Service-to-service auth (ALL timing-safe compared) ───
# Agent -> backend ingest (X-API-Key on /api/agent/*)
AGENT_API_KEY=<generate-with-openssl-rand-hex-32>

# CV service -> backend detection ingest (X-API-Key on POST /api/cameras/detections).
# Must match CV_INGEST_KEY in cv-service env. If unset, the ingest endpoint
# is UNAUTHENTICATED (development only — production boot check enforces it).
CV_INGEST_KEY=<generate-with-openssl-rand-hex-32>

# Comma-separated keys accepted by `protect` for service calls (X-API-Key)
API_KEYS=<generate-with-openssl-rand-hex-32>

# CORS origins (comma-separated; '*' only in development)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ---- Token lifecycle ----
# Access tokens are short-lived; refresh tokens live in an httpOnly cookie
# (POST /api/auth/refresh rotates them automatically from the frontend).
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d

# ---- Redis (optional) ----
# Unset = in-memory token blacklist + rate limiting (single instance only)
# REDIS_URL=redis://localhost:6379

# ---- Data retention ----
DETECTION_RETENTION_DAYS=90

# Debug only: disables ALL rate limiters (never set in production)
# RATE_LIMIT_DISABLED=true

# ── Alert notifications (all channels optional) ──────────────
# Generic JSON webhook (receives X-Aiboo-Signature: sha256=HMAC when
# NOTIFICATION_HMAC_SECRET is set — verify integrity receiver-side)
# ALERT_WEBHOOK_URL=https://hooks.example.com/aiboo
# Slack incoming webhook
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# PagerDuty Events API v2 routing key
# ALERT_PAGERDUTY_ROUTING_KEY=
# SIEM forwarding — events sent as CEF strings (Splunk/Elastic HTTP collectors)
# SIEM_WEBHOOK_URL=https://splunk.example.com:8088/services/collector/event
# Signs outgoing generic webhooks
# NOTIFICATION_HMAC_SECRET=
# Which severities fan out (comma-separated)
ALERT_NOTIFY_SEVERITIES=critical
NOTIFICATION_DEDUPE_MS=60000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY_MS=5000

# Trust proxy count (set to number of reverse proxies in front)
TRUST_PROXY=1

# Seed demo agent findings on boot (dev only)
SEED_DEMO_DATA=false
