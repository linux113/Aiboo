# ── Agent API ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001

# Backend the agent pushes findings/alerts to.
# Priority: REMOTE_URL > NODE_BACKEND > config.ini > http://localhost:4000
# For tunnels (ngrok etc.) inject the URL HERE at runtime — never hardcode it.
NODE_BACKEND=http://localhost:4000
REMOTE_URL=http://localhost:4000

# Endpoint identity
ENDPOINT_NAME=My_PC

# ── Secrets ───────────────────────────────────────────────
# Must match backend AGENT_API_KEY (production boot FAILS on defaults)
AGENT_API_KEY=<generate-with-openssl-rand-hex-32>
# Must match backend internal key used by dashboard
INTERNAL_API_KEY=<generate-with-openssl-rand-hex-32>

# Set to production to enable fail-fast secret checks
AIBOO_ENV=development

# Backend service account for agent -> backend JWT auth (optional)
BACKEND_EMAIL=admin@example.com
BACKEND_PASSWORD=change-me

# ── Engines ───────────────────────────────────────────────
# Observability engine (safe)
ENABLE_COMMAND_DASHBOARD=true
# Action engines — take REAL host actions (kill/lock). Opt-in.
ENABLE_AUTONOMOUS_RESPONSE=false
ENABLE_REAL_RESPONSE=false

# ── Data / runtime ────────────────────────────────────────
LOG_LEVEL=INFO
DB_TYPE=memory
DATABASE_URL=
EVENT_TTL_SECONDS=3600
MAX_DICT_SIZE=10000
REQUEST_TIMEOUT=30
# SQLite offline queue path (docker-compose mounts a volume here)
ALERT_QUEUE_DB_PATH=

# ── LLM (optional) ────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-haiku-20240307
RATE_LIMIT_PER_MINUTE=60
